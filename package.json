{
  "name": "ptcg-agent-table",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "check:backend": "tsc --noEmit",
    "check:web": "tsc -p apps/web/tsconfig.json",
    "test": "npm run test:agent && npm run test:core && npm run test:server && npm run test:web",
    "test:agent": "node --test packages/agent/test/*.test.ts",
    "test:core": "node --test packages/game-core/test/*.test.ts",
    "test:server": "node --test apps/server/test/*.test.ts",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "dev:server": "node --watch apps/server/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "docs:prompts": "node scripts/audit-prompts.ts",
    "validate:snapshot": "node scripts/snapshot-validation.ts",
    "start": "node apps/server/src/main.ts",
    "validate:agent": "node scripts/validate-agent.ts",
    "validate:throughput": "node scripts/validate-throughput.ts",
    "report:usage": "node scripts/report-usage.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/static": "10.1.7",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "fastify": "5.12.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
